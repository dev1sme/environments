# Domain nội bộ. Đổi công ty: `make domain-set d=<domain-moi>`
DOMAIN=thomson.cba

POSTGRES_USER=dev
POSTGRES_PASSWORD=changeme

# IP LAN của host. Lấy bằng:
#   ip -4 addr show | grep -oP 'inet \K[\d.]+' | grep -v '^127\.'
HOST_IP=10.11.15.129

# Gốc cây source code. codegraph mount TRÙNG đường dẫn này, không phải
# /workspace. Tuyệt đối, không dấu / ở cuối.
PROJECTS_ROOT=/home/thomson/dev/project

# uid/gid host. Sai là codegraph ghi .codegraph/ bị EACCES. `id -u; id -g`
HOST_UID=1001
HOST_GID=1001
