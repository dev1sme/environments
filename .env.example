# Domain nội bộ. Đổi công ty thì `make domain-set d=<domain-moi>` —
# nó sửa cả server_name trong nginx conf, không chỉ biến này.
DOMAIN=thomson.cba

POSTGRES_USER=dev
POSTGRES_PASSWORD=changeme

# IP LAN của máy host. coredns bind riêng vào IP này (không bind 0.0.0.0
# vì host đang có systemd-resolved giữ 127.0.0.53:53).
# Lấy bằng: ip -4 addr show | grep -oP 'inet \K[\d.]+' | grep -v '^127\.'
HOST_IP=10.11.15.129

# Gốc cây source code. codegraph mount TRÙNG đường dẫn này vào container
# (không phải /workspace) để `rootUri` mà Claude Code gửi dùng được thẳng.
# Đường dẫn tuyệt đối, không có dấu / ở cuối.
PROJECTS_ROOT=/home/thomson/dev/project

# uid/gid của user host. codegraph ghi <project>/.codegraph/ ra bind mount,
# chạy sai uid là EACCES. docker-starfish hardcode 1000 — máy này là 1001,
# nên đừng copy số đó sang.
# Lấy bằng: id -u; id -g
HOST_UID=1001
HOST_GID=1001
