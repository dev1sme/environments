.data/
.env
tools/ssl-cert/self.key

# Zone file thật chứa IP theo từng máy — sinh bằng `make dns-init`.
# Pattern lấy từ docker-starfish: commit .example, ignore file thật.
tools/coredns/zones/*
!tools/coredns/zones/*.example

# Basic auth cho codegraph UI — sinh bằng `make cg-auth u=<user>`.
tools/proxy/auth/*
!tools/proxy/auth/.gitkeep
