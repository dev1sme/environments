# App mới: copy thành <app>.conf, sửa server_name + giá trị $upstream.
# Header proxy, timeout, body size, inject dev.js: đã lo ở 00-defaults.conf
# và snippets/. Mấy chỗ dễ sập: ../README.md

server {
    listen 80;
    server_name app.thomson.cba;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name app.thomson.cba;

    ssl_certificate     /etc/nginx/ssl/self.crt;
    ssl_certificate_key /etc/nginx/ssl/self.key;

    include /etc/nginx/snippets/dev-badge.conf;

    location / {
        # Upstream PHẢI trong biến. Viết literal thì app tắt là CẢ PROXY chết,
        # kéo theo mọi app khác. Xem ../README.md
        set $upstream http://app:3000;
        include /etc/nginx/snippets/proxy-params.conf;
        proxy_pass $upstream;
    }
}
