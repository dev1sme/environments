; Template zone. `make dns-init` thay __DOMAIN__ / __HOST_IP__ rồi ghi ra
; zones/<DOMAIN>.db (file thật bị gitignore).

$ORIGIN __DOMAIN__.
$TTL 86400
@   IN  SOA dns.__DOMAIN__. root.__DOMAIN__. (
        2026090700 ; Serial — tăng mỗi lần sửa zone
        7200       ; Refresh
        3600       ; Retry
        1209600    ; Expire
        3600       ; Minimum TTL
)
@       IN  NS  dns.__DOMAIN__.

@       IN  A   __HOST_IP__
dns     IN  A   __HOST_IP__

; Wildcard — app mới chỉ cần thêm file .conf ở tools/proxy/conf.d/
*       IN  A   __HOST_IP__
