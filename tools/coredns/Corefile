# `{$DOMAIN}` là env substitution của CoreDNS — biến truyền từ compose, nên
# file này không hardcode domain. Lưu ý: `header { }` phải viết nhiều dòng.

{$DOMAIN}:53 {
    header {
        response set ra
    }

    root /etc/coredns/zones
    file {$DOMAIN}.db {$DOMAIN}

    log
    errors
}

# Domain khác forward ra ngoài — client trỏ DNS về đây vẫn duyệt internet
.:53 {
    forward . 1.1.1.1 8.8.8.8
    cache 30
    log
    errors
}
